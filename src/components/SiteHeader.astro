---
const navItems = [
  { href: '#services', label: 'Services' },
  { href: '#approach', label: 'Approach' },
  { href: '#fit', label: 'Best Fit' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="site-header" aria-label="Primary">
  <a class="brand" href="/" aria-label="Timberline Technical Systems home">
    <span class="brand-mark">TTS</span>
    <span class="brand-copy">
      <strong>Timberline Technical Systems</strong>
      <small>fielded software • hardware-aware systems • technical stewardship</small>
    </span>
  </a>

  <nav class="nav-links" aria-label="Main navigation">
    {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>

  <a class="header-cta" href="#contact">Start the conversation</a>
</header>
