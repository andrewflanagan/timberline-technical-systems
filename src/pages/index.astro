---
import SiteLayout from '../layouts/SiteLayout.astro';

const services = [
  {
    title: 'Engineering Solutions',
    body: 'Practical system design for products, operations, and technical teams that need clarity before momentum turns expensive.',
    points: ['System strategy', 'Interface definition', 'Risk reduction'],
  },
  {
    title: 'Business Solutions',
    body: 'Translate messy operational needs into workable plans, better processes, and technical decisions that support the business.',
    points: ['Workflow design', 'Decision support', 'Operational planning'],
  },
  {
    title: 'Complex Problem Recovery',
    body: 'Bring structure to stalled initiatives, unclear ownership, brittle handoffs, and projects that need a steady technical lead.',
    points: ['Architecture recovery', 'Team alignment', 'Execution plans'],
  },
  {
    title: 'Delivery Readiness',
    body: 'Make the path to launch more predictable with evidence, documentation, validation, and operating habits that last.',
    points: ['Readiness reviews', 'Documentation', 'Sustained operations'],
  },
];

const approach = [
  ['01', 'Map the terrain', 'Understand the constraints, stakeholders, operating realities, and places where risk is quietly nesting.'],
  ['02', 'Shape the system', 'Turn ambiguity into explicit boundaries, contracts, and decision records that humans can actually use.'],
  ['03', 'Prove the path', 'Deliver focused, verifiable increments that show the solution works in the real operating context.'],
  ['04', 'Leave the trail marked', 'Hand off documentation, tests, release evidence, and operating notes so the system can keep moving.'],
];
---

<SiteLayout>
  <section class="hero section-pad">
    <div class="hero-copy">
      <p class="eyebrow">Technical systems, polished brighter</p>
      <h1>Engineering help for systems that touch risk, operations, and reality.</h1>
      <p class="hero-lede">
        Timberline Technical Systems helps teams clarify complex problems, shape practical solutions, and connect technical decisions to business outcomes.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#contact">Start a project</a>
        <a class="btn btn-secondary" href="#services">Explore services</a>
      </div>
    </div>

    <aside class="hero-card" aria-label="Positioning summary">
      <svg class="terrain-mark" viewBox="0 0 420 220" role="img" aria-label="Timberline mountain and trees">
        <path class="terrain-line ridge-back" d="M18 138 L92 64 L140 116 L197 45 L278 136 L329 88 L402 154" />
        <path class="terrain-line ridge-front" d="M22 166 L118 82 L174 146 L230 86 L312 164 L398 112" />
        <path class="terrain-line ground" d="M24 188 H396" />
        <path class="tree tree-a" d="M78 186 V119 M47 162 L78 119 L109 162 M55 142 L78 106 L101 142" />
        <path class="tree tree-b" d="M333 188 V108 M294 166 L333 108 L372 166 M305 143 L333 94 L361 143" />
        <path class="tree tree-c" d="M270 188 V133 M246 166 L270 133 L294 166 M251 151 L270 121 L289 151" />
      </svg>
      <p class="card-kicker">Systems that behave</p>
      <h2>From fuzzy problems to workable plans.</h2>
      <p>
        Technical stewardship for organizations that need sound engineering judgment, business context, and fewer surprises.
      </p>
      <div class="metric-row">
        <span><strong>01</strong> clarify</span>
        <span><strong>02</strong> integrate</span>
        <span><strong>03</strong> sustain</span>
      </div>
    </aside>
  </section>

  <section class="section-pad intro-grid" aria-label="Core positioning">
    <div>
      <p class="eyebrow">Why this work matters</p>
      <h2>Engineering solutions should make business decisions easier.</h2>
    </div>
    <p>
      Timberline Technical Systems is built around a simple conviction: good engineering is practical service. The work is to understand the real constraint, respect the people carrying it, and shape a solution that is clear enough to build, operate, explain, and trust.
    </p>
  </section>

  <section id="services" class="section-pad">
    <div class="section-heading">
      <p class="eyebrow">Services</p>
      <h2>Useful where technical choices shape business outcomes.</h2>
    </div>
    <div class="service-grid">
      {services.map((service) => (
        <article class="service-card">
          <h3>{service.title}</h3>
          <p>{service.body}</p>
          <ul>
            {service.points.map((point) => <li>{point}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section id="approach" class="section-pad approach-section">
    <div class="section-heading narrow">
      <p class="eyebrow">Approach</p>
      <h2>Enough structure to move with confidence.</h2>
    </div>
    <div class="timeline">
      {approach.map(([number, title, body]) => (
        <article class="timeline-item">
          <span>{number}</span>
          <div>
            <h3>{title}</h3>
            <p>{body}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="fit" class="section-pad fit-section">
    <div class="fit-panel">
      <p class="eyebrow">Best fit</p>
      <h2>Bring the messy middle.</h2>
      <p>
        The sweet spot is a problem with real constraints: unclear ownership, brittle handoffs, stalled technical decisions, operational friction, fragile release confidence, or a business need that deserves cleaner engineering judgment.
      </p>
      <div class="fit-list">
        <span>Engineering strategy</span>
        <span>Business process design</span>
        <span>Technical leadership</span>
        <span>Operational readiness</span>
        <span>Architecture recovery</span>
        <span>Delivery planning</span>
      </div>
    </div>
  </section>

  <section id="contact" class="section-pad contact-section">
    <div>
      <p class="eyebrow">Contact</p>
      <h2>Tell us what needs to work.</h2>
      <p>
        Share the outcome, obstacle, or decision in front of you. We will help turn it into a practical path forward.
      </p>
    </div>
    <form class="contact-form" name="contact" method="post">
      <label>
        Name
        <input name="name" type="text" autocomplete="name" />
      </label>
      <label>
        Email
        <input name="email" type="email" autocomplete="email" />
      </label>
      <label>
        What are you building?
        <textarea name="message" rows="5"></textarea>
      </label>
      <button class="btn btn-primary" type="submit">Send message</button>
      <p class="form-note">Or email directly at <a href="mailto:hello@timberlinetechnicalsystems.com">hello@timberlinetechnicalsystems.com</a></p>
    </form>
  </section>
</SiteLayout>
